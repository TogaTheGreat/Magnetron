<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Also includes Mon-D speaker at the back -->
  <link name="mon_d_speaker">
    <collision>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0275" length="0.045"/>
      </geometry>
    </collision>
    <visual>
      <origin xyz="0 0 0.0225" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.0275" length="0.045"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="box_to_spk" type="fixed">
    <parent link="box_rotate"/>
    <child link="mon_d_speaker"/>
    <origin xyz="-0.062 0 -0.019" rpy="0 0 0"/>
  </joint>

  <!-- Small fixed mast/base for the camera servo assembly -->
  <link name="camera_mount_link">
    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <geometry>
        <box size="0.08 0.08 0.07"/>
      </geometry>
    </collision>
  </link>

  <!-- Bracket1 split into its own fixed visual link so it can keep a separate material.
       The joint origin is the old visual origin, so this TF represents the mesh pose. -->
  <link name="camera_mount_bracket1_link">
    <visual name="bracket1_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mondy_description/meshes/camera/bracket1.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="camera_mount_to_bracket1" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="camera_mount_bracket1_link"/>
    <origin xyz="0 0 0.0165" rpy="0 0 3.141592"/>
  </joint>

  <link name="pan_servo">
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 3.141592"/>
      <geometry>
        <mesh filename="package://mondy_description/meshes/camera/mg995.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <joint name="frame_to_camera_mount" type="fixed">
    <parent link="box_rotate"/>
    <child link="camera_mount_link"/>
    <origin xyz="0.2115 0.01 -0.019" rpy="0 0.0698132 0"/>
  </joint>

  <joint name="mount_to_pan_servo" type="fixed">
    <parent link="camera_mount_link"/>
    <child link="pan_servo"/>
    <origin xyz="0.0264 -0.012 0.005" rpy="0 0 0"/>
  </joint>

  <!-- Pan servo body -->
  <link name="camera_pan_link">
    <visual>
      <origin xyz="0.026 0.01 0.008" rpy="0 0 3.141592"/>
      <geometry>
        <mesh filename="package://mondy_description/meshes/camera/mg995.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.026 0.01 0.008" rpy="0 0 3.141592"/>
      <geometry>
        <mesh filename="package://mondy_description/meshes/camera/mg995.stl"/>
      </geometry>
    </collision>
  </link>

  <joint name="camera_pan" type="revolute">
    <parent link="camera_mount_link"/>
    <child link="camera_pan_link"/>
    <origin xyz="0.012 0 0.044" rpy="0 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.5708" upper="1.5708" effort="1.0" velocity="3.0"/>
  </joint>

  <!-- Tilt bracket -->
  <link name="camera_tilt_link">
    <visual>
      <origin xyz="0.05 0.028 0" rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="package://mondy_description/meshes/camera/servobracketu.stl"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin xyz="0.05 0.028 0" rpy="1.5708 0 -1.5708"/>
      <geometry>
        <mesh filename="package://mondy_description/meshes/camera/servobracketu.stl"/>
      </geometry>
    </collision>
  </link>

  <!-- Bracket2 split into its own fixed visual link so it can keep a separate material.
       The joint origin is the old visual origin, so this TF represents the mesh pose. -->
  <link name="camera_tilt_bracket2_link">
    <visual name="bracket2_visual">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://mondy_description/meshes/camera/bracket2.stl"/>
      </geometry>
      <material name="white"/>
    </visual>
  </link>

  <joint name="camera_tilt_to_bracket2" type="fixed">
    <parent link="camera_tilt_link"/>
    <child link="camera_tilt_bracket2_link"/>
    <origin xyz="0.0515 0.028 0" rpy="0 1.5708 0"/>
  </joint>

  <joint name="camera_tilt" type="revolute">
    <parent link="camera_pan_link"/>
    <child link="camera_tilt_link"/>
    <origin xyz="0.01 -0.038 0.018" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.7854" upper="0.7854" effort="1.0" velocity="3.0"/>
  </joint>

  <!-- DepthAI's external mount frame. The camera driver owns oak and its
       calibrated optical/IMU descendants below this frame. -->
<link name="oak-d-base-frame">
  <visual>
    <origin xyz="0 0 0" rpy="-1.5708 3.141592 -1.5708"/>
    <geometry>
      <mesh filename="package://depthai_descriptions/urdf/models/OAK-D-PRO.stl" scale="1 1 1"/>
    </geometry>
    <material name="black"/>
  </visual>

  <collision>
    <origin xyz="0 0 0" rpy="-1.5708 3.141592 -1.5708"/>
    <geometry>
      <mesh filename="package://depthai_descriptions/urdf/models/OAK-D-PRO.stl" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

  <joint name="tilt_to_oak" type="fixed">
    <parent link="camera_tilt_link"/>
    <child link="oak-d-base-frame"/>
    <!-- TODO: calibrate OAK IMU axes -->
    <origin xyz="0.074 0.028 0.0055" rpy="0 0.453786 0"/>
  </joint>

</robot>
