<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mondy">

  <!-- OSR/JPL rover body, wheels, rocker-bogie, collisions, visuals -->
  <xacro:include filename="$(find mondy_description)/urdf/osr_model.macro.xacro"/>
  <xacro:include filename="$(find mondy_description)/urdf/materials.xacro"/>
  <xacro:osr_model/>

  <!-- Mon-D-specific camera mount -->
  <xacro:include filename="$(find mondy_description)/urdf/camera_mount.xacro"/>
  <xacro:include filename="$(find mondy_description)/urdf/roarm_m3.macro.xacro"/>
  <xacro:roarm_m3/>
</robot>
